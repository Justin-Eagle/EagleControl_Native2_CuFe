<Window x:Class="EagleControl_Native2_CuFe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EagleControl_Native2_CuFe"
        mc:Ignorable="d"
        Title="EagleControl_Native2_CuFe v1.0.5" Height="1070" Width="1920" Background="Black" WindowState="Maximized">

    <Window.Resources>
        <Style x:Key="CircularButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="100*"/>
                            </Grid.RowDefinitions>
                            <Ellipse x:Name="ellipse" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Fill="{TemplateBinding Background}" Grid.RowSpan="2"/>
                            <ContentPresenter Grid.Row="1">
                                <ContentPresenter.Content>
                                    <TextBlock Text="{TemplateBinding Content}" TextAlignment="Center" VerticalAlignment="Center"/>
                                </ContentPresenter.Content>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ellipse" Property="Stroke" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ellipse" Property="Stroke" Value="Black"/>
                                <Setter TargetName="ellipse" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="2*"/>

        </Grid.RowDefinitions>

        <Rectangle Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"  Margin="3,5,3,3" Fill="#9D9D9D" RadiusX="7"  RadiusY="7"/>
        <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"  Margin="3,0,3,5" Fill="#9D9D9D" RadiusX="7"  RadiusY="7"/>
        <Rectangle Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"  Margin="3,0,3,5" Fill="#9D9D9D" RadiusX="7"  RadiusY="7"/>


        <Border Margin="6,8,0,8" Grid.Row="0" Grid.Column="0" BorderBrush="LightGray" BorderThickness="2" CornerRadius="5" Grid.ColumnSpan="2">
            <StackPanel>

                <StackPanel Margin="50,0,0,0" Orientation="Horizontal" HorizontalAlignment="Center" Width="180">
                    <Label  Margin="0,5,0,0" Content="機台狀態" FontSize="25" FontWeight="Bold" />
                    <Button Margin="10,3,0,0" Height="21" Width="55" Content="畫面清除" FontWeight="Bold" FontSize="11" IsEnabled="{Binding IsDataMonitorLogEraseButtonEnabled}" Command="{Binding DataMonitorLogEraseCommand}" Click="Button_Click"></Button>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">

                    <TextBox x:Name="Monitor1" FontSize="20"  Margin="0,5,0,5" Width="600" Height="360" Grid.Row="0" Grid.Column="1" Background="White" TextAlignment="Left" VerticalContentAlignment="Top" BorderThickness="1" HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" IsReadOnly="True"></TextBox>

                </StackPanel>
            </StackPanel>

        </Border>

        <Border Margin="6,8,0,8" Grid.Row="0" Grid.Column="2" BorderBrush="LightGray" BorderThickness="2" CornerRadius="5">
            <StackPanel>

                <StackPanel Margin="50,0,0,0" Orientation="Horizontal" HorizontalAlignment="Center" Width="180">
                    <Label  Margin="0,5,0,0" Content="警報狀態" FontSize="25" FontWeight="Bold" />
                    <Button Margin="10,3,0,0" Height="21" Width="52" Content="畫面清除" FontWeight="Bold" FontSize="11" IsEnabled="{Binding IsDataMonitorLogEraseButtonEnabled}" Command="{Binding DataMonitorLogEraseCommand}" Click="Button_Click_1"></Button>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">

                    <TextBox x:Name="Monitor2" FontSize="20"  Margin="0,5,0,5" Width="600" Height="360"  Grid.Row="0" Grid.Column="1" Background="White" TextAlignment="Left" VerticalContentAlignment="Top" BorderThickness="1" HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding DataMonitorLog, Mode=OneWay }" IsReadOnly="True"></TextBox>

                </StackPanel>
            </StackPanel>

        </Border>

        <Border Margin="6,8,6,8" Grid.Row="0" Grid.Column="3" BorderBrush="LightGray" BorderThickness="2" CornerRadius="5">
            <StackPanel>

                <StackPanel Margin="50,0,0,0" Orientation="Horizontal" HorizontalAlignment="Center" Width="180">
                    <Label  Margin="0,5,0,0" Content="分析結果" FontSize="25" FontWeight="Bold" />
                    <Button Margin="10,3,0,0" Height="21" Width="52" Content="畫面清除" FontWeight="Bold" FontSize="11" IsEnabled="{Binding IsDataMonitorLogEraseButtonEnabled}" Command="{Binding DataMonitorLogEraseCommand}" Click="Button_Click_2"></Button>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">

                    <TextBox x:Name="Monitor3" FontSize="20"  Margin="0,5,0,5" Width="600" Height="360"  Grid.Row="0" Grid.Column="1" Background="White" TextAlignment="Left" VerticalContentAlignment="Top" BorderThickness="1" HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding DataMonitorLog, Mode=OneWay }" IsReadOnly="True"></TextBox>

                </StackPanel>
            </StackPanel>

        </Border>

        <Border Margin="6,3,0,8" Grid.Row="1" Grid.Column="0" BorderBrush="LightGray" BorderThickness="2" CornerRadius="5" Grid.ColumnSpan="2">
            <StackPanel>

                <StackPanel Margin="50,0,0,0" Orientation="Horizontal" HorizontalAlignment="Center" Width="180">
                    <Label  Margin="0,5,0,0" Content="滴定過程" FontSize="25" FontWeight="Bold" />
                    <Button Margin="10,3,0,0" Height="21" Width="52" Content="畫面清除" FontWeight="Bold" FontSize="11" IsEnabled="False"></Button>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">

                    <TextBox x:Name="Monitor4" FontSize="20"  Margin="0,5,0,5" Width="600" Height="360"  Grid.Row="0" Grid.Column="1" Background="LightGray" TextAlignment="Left" VerticalContentAlignment="Top" BorderThickness="1" HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding DataMonitorLog, Mode=OneWay }" IsReadOnly="True" ></TextBox>

                </StackPanel>
            </StackPanel>

        </Border>

        <Border Margin="6,3,0,8" Grid.Row="1" Grid.Column="2" BorderBrush="LightGray" BorderThickness="2" CornerRadius="5">
            <StackPanel>

                <StackPanel Margin="50,0,0,0" Orientation="Horizontal" HorizontalAlignment="Center" Width="180">
                    <Label  Margin="0,5,0,0" Content="校正參數" FontSize="25" FontWeight="Bold" />
                    <Button Margin="10,3,0,0" Height="21" Width="52" Content="畫面清除" FontWeight="Bold" FontSize="11" IsEnabled="{Binding IsDataMonitorLogEraseButtonEnabled}" Command="{Binding DataMonitorLogEraseCommand}" Click="Button_Click_3"></Button>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">

                    <TextBox x:Name="Monitor5" FontSize="20"  Margin="0,5,0,5" Width="600" Height="360"  Grid.Row="0" Grid.Column="1" Background="White" TextAlignment="Left" VerticalContentAlignment="Top" BorderThickness="1" HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding DataMonitorLog, Mode=OneWay }" IsReadOnly="True"></TextBox>

                </StackPanel>
            </StackPanel>

        </Border>

        <Border Margin="6,3,6,8" Grid.Row="1" Grid.Column="3" BorderBrush="LightGray" BorderThickness="2" CornerRadius="5">
            <StackPanel>

                <StackPanel Margin="50,0,0,0" Orientation="Horizontal" HorizontalAlignment="Center" Width="180">
                    <Label  Margin="0,5,0,0" Content="監控紀錄" FontSize="25" FontWeight="Bold" />
                    <Button Margin="10,3,0,0" Height="21" Width="52" Content="畫面清除" FontWeight="Bold" FontSize="11" IsEnabled="{Binding IsDataMonitorLogEraseButtonEnabled}" Command="{Binding DataMonitorLogEraseCommand}" Click="Button_Click_4"></Button>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">

                    <TextBox x:Name="Monitor6" FontSize="20" Margin="0,5,0,5" Width="600" Height="360"  Grid.Row="0" Grid.Column="1" Background="White" TextAlignment="Left" VerticalContentAlignment="Top" BorderThickness="1" HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" IsReadOnly="True"></TextBox>

                </StackPanel>
            </StackPanel>

        </Border>
        <Label Grid.Column="2" Content="Station Number" HorizontalAlignment="Left" Margin="40,32,0,0" Grid.Row="2" VerticalAlignment="Top" FontSize="25" FontWeight="Bold" Width="210"/>
        <TextBox x:Name="StationNum" Grid.Column="2" HorizontalAlignment="Right" Margin="0,32,320,0" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Top" Width="65" Height="41" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="1" FontSize="20" FontWeight="Bold"/>
        <Button x:Name="GoButton" Style="{StaticResource CircularButtonStyle}" Grid.Column="2" Content="GO" HorizontalAlignment="Left" Margin="475,11,0,0" Grid.Row="2" VerticalAlignment="Top" Height="80" Width="90" FontWeight="Bold" FontSize="40" Background="Green" Click="GoButton_Click"/>
        <Button x:Name="StopButton" Style="{StaticResource CircularButtonStyle}" Grid.Column="2" Content="STOP" HorizontalAlignment="Left" Margin="365,11,0,0" Grid.Row="2" VerticalAlignment="Top" Height="80" Width="90" FontWeight="Bold" Background="Gray" FontSize="30" IsEnabled="False" Click="StopButton_Click"/>

        <Button x:Name="HeartBeatBtn1" Style="{StaticResource CircularButtonStyle}" Grid.Column="2" Content="" HorizontalAlignment="Right" Margin="0,38,34,0" Grid.Row="2" VerticalAlignment="Top" Height="11" Width="11" BorderBrush="Black" Background="black" BorderThickness="5" RenderTransformOrigin="12.28,0.343" IsEnabled="False"/>

        <Button x:Name="HeartBeatBtn2" Style="{StaticResource CircularButtonStyle}" Grid.Column="2" Content="" HorizontalAlignment="Right" Margin="0,57,34,0" Grid.Row="2" VerticalAlignment="Top" Height="11" Width="11" BorderBrush="Black" Background="black" BorderThickness="5" RenderTransformOrigin="12.28,0.343" IsEnabled="False"/>

    </Grid>
</Window>
